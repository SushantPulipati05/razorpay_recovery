PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/razor_recover"

# Razorpay Webhook & API Credentials
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
RAZORPAY_WEBHOOK_SECRET="test_webhook_secret_12345"

# Recovery Agent LLM (Groq) — https://console.groq.com
GROQ_API_KEY="gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Twilio WhatsApp Integration — https://console.twilio.com
# Live Twilio dispatch is currently commented out in src/integrations/whatsapp.ts
# (trial account hit its billing wall + ContentSid template requirement).
# These are still read by src/config/env.ts; leave blank to run in
# console-simulated WhatsApp mode.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886"
# Only needed if you re-enable live dispatch via an approved Content Template.
TWILIO_CONTENT_SID=""
